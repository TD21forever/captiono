{
  "name": "captiono",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:extension": "vite build && vite build --config vite.extension.config.mjs && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/core.test.mjs",
    "test:extension:cdp": "node scripts/verify-extension-cdp.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "3.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
